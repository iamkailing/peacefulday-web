# Copy to .env for local development (the server reads real environment variables;
# e.g. `set -a; . ./.env; set +a; go run ./cmd/server`). Never commit real secrets.

# --- core ---
APP_ENV=development            # development | staging | production
PORT=8080
BASE_URL=http://localhost:8080 # public address, no trailing slash (on Render it defaults to the onrender.com URL)
DATABASE_URL=postgres://postgres@127.0.0.1:5432/peacefulday?sslmode=disable
SESSION_SECRET=                # required outside development: 32+ random characters

# --- payments ---
PAYMENT_PROVIDER=simulated     # simulated (development/staging only) | stripe
STRIPE_SECRET_KEY=             # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=         # whsec_... from your webhook endpoint
# STRIPE_API_BASE=https://api.stripe.com   # only changed in tests

# --- first owner login (only used while no owner exists) ---
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# --- email (optional; messages are logged as "skipped" until set) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=                     # Peaceful Day <hello@example.com>
ADMIN_ALERT_EMAIL=

# --- marketing (optional) ---
META_CAPI_ACCESS_TOKEN=        # Meta Conversions API token (Pixel ID is set in Admin → Marketing)
LINE_CHANNEL_ACCESS_TOKEN=     # reserved for the future LINE OA integration (not used yet)

# --- development helpers ---
# ASSETS_DIR=./internal/app    # serve templates/CSS/JS from disk with live reload (development only)
# DISABLE_WORKERS=1            # don't run background jobs (hold expiry, reminders, email delivery)
